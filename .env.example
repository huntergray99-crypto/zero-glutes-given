# Copy to .env and fill in. None of these are secrets in the usual sense —
# they're just not things to commit. Anything without a VITE_ prefix is used
# only by build scripts and never reaches the browser bundle.

# --- build scripts only ---

# Yelp Fusion key for scripts/fetch-photos.mjs (real per-restaurant photos).
# Free, no billing: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=

# --- shipped to the client (VITE_ prefix) ---

# MapTiler key → Light + Dark basemaps use MapTiler Streets (the Apple/Google
# look). A working key is already baked into src/components/MapView.jsx as the
# default (client keys ship in the bundle regardless); set this only to use a
# different key locally. Manage keys: https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_KEY=

# DoorDash + Uber run consumer affiliate programs through impact.com. Once
# approved, paste the tracking link with the literal token {u} where the
# destination URL goes. Unset = links work, just no commission.
#   VITE_AFFIL_DOORDASH="https://doordash.pxf.io/c/PUBID/CAMPAIGN/ADID?u={u}"
VITE_AFFIL_DOORDASH=
VITE_AFFIL_UBEREATS=

# Stripe Payment Link for Zero Glutes Premium (test mode while building,
# swap for the live link when ready to actually charge people). Create one:
# Stripe Dashboard → Payment links → New → set the success URL to
# https://zeroglutesgiven.culebramaps.com/?upgraded=1
# Unset = the upgrade button shows "coming soon" instead of redirecting.
VITE_STRIPE_PAYMENT_LINK=
