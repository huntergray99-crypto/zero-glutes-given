# Copy to .env and fill in once the affiliate programs are approved.
# These are click-tracking links, not secrets — they just don't belong in git.
#
# DoorDash + Uber both run their consumer affiliate programs through impact.com.
# After you're approved, Impact gives you a tracking link per program. Paste it
# here with the literal token {u} where the destination URL goes.
#
# Example shape (yours will have real IDs):
#   VITE_AFFIL_DOORDASH="https://doordash.pxf.io/c/1234567/2098019/12139?u={u}"
#   VITE_AFFIL_UBEREATS="https://ubereats.pxf.io/c/1234567/2109605/13579?u={u}"
#
# Leave unset and every order link still works — just without commission.

VITE_AFFIL_DOORDASH=
VITE_AFFIL_UBEREATS=
