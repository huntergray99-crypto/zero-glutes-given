rules_version = '2';

// Zero Glutes Given — shared social layer.
// Paste this into: Firebase console → Firestore Database → Rules → Publish.
//
// Model:
//   posts/{id}  — public read; any signed-in user (Google or anonymous) can
//                 create a post they own; only the author can edit/delete it.
//   users/{uid} — public read (leaderboard + handles); a user may only write
//                 their own card.

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin allowlist. Add a doc here (id = the account's uid) from the
    // Firebase console to grant triage access — no custom claims, no
    // server-side tooling. Nobody can write it from the client.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{adminId} {
      allow get: if request.auth != null && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Runtime corrections layered over the bundled restaurant data. Public
    // read — every visitor needs corrections applied, that's the point.
    // Admin-only write: these change published celiac safety claims.
    match /restaurantOverrides/{restaurantId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.handle is string
        && request.resource.data.tags is list;

      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.glutened is bool
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.handle is string;

      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // One doc per (user, restaurant) pair, id `${uid}_${restaurantId}`. Visit
    // history is per-user data, not a public feed — owner-only read/write.
    match /checkIns/{checkInId} {
      allow read: if request.auth != null
        && resource.data.uid == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.visits is list;

      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.visits is list;

      allow delete: if false;
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.restaurantId is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.handle is string;

      allow update, delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.points is number
        && request.resource.data.handle is string
        && request.resource.data.handle.size() <= 24;
    }

    // Community corrections / suggestions. Anyone may file one (auth
    // optional); only an allowlisted admin can read or triage them.
    match /reports/{reportId} {
      allow read: if isAdmin();

      allow update: if isAdmin()
        && request.resource.data.status in ['open', 'resolved'];

      allow delete: if false;

      allow create: if request.resource.data.type is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() <= 200;
    }
  }
}
